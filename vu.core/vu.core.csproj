<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Version>0.1.0</Version>
        <Title>auto</Title>
        <Description>pw bot core</Description>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <AssemblyName>vusharp.core</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore" Version="2.3.10" />
      <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />
      <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
      <PackageReference Include="vusharp.task" Version="0.0.1" />
      <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
    </ItemGroup>

</Project>
